{
  "name": "@graduate-me/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "db:generate": "node --import tsx ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format && pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:show": "node --import tsx ./node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/express": "0.12.3",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/typeorm": "12.0.2",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.31",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
